generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              Int     @id @default(autoincrement())
  email           String  @unique
  password        String
  esAdmin         Boolean @default(false)
  esSuperAdmin    Boolean @default(false)
  nombre          String  @default("Admin")
  permisoClientes Boolean @default(false)
  permisoFeriados Boolean @default(false)
  permisoFinanzas Boolean @default(false)
  permisoPlanes   Boolean @default(false)
  permisoTurnos   Boolean @default(false)
  usuario         String  @unique

  @@map("usuarios")
}

model ConfiguracionLocal {
  id                       Int       @id @default(autoincrement())
  logo_url                 String?
  nombre                   String?
  direccion                String?
  telefono                 String?
  instagram                String?
  whatsapp                 String?
  hora_apertura            DateTime? @db.Time(0)
  hora_cierre              DateTime? @db.Time(0)
  capacidad_max_hora       Int       @default(0)
  margen_cancelacion_horas Int       @default(0)
  bloqueo_capacidad        Boolean   @default(false)

  @@map("configuracion_local")
}

model Plan {
  id              Int         @id @default(autoincrement())
  nombre          String
  etiqueta        String?
  precio          Decimal     @db.Decimal(10, 2)
  frecuencia      String
  caracteristicas String?     @db.Text
  activo          Boolean     @default(true)
  codigo          String?     @unique
  observaciones   String?     @db.Text
  categorias      Categoria[]

  @@map("planes")
}

model Cliente {
  id               Int                @id @default(autoincrement())
  codigo_socio     String?            @unique
  nombre           String
  apellido         String
  dni_cuit         String             @unique
  email            String?            @unique
  telefono         String?
  fecha_inicio     DateTime?          @db.Date
  observaciones    String?            @db.Text
  estado_pago      EstadoPago         @default(ALDIA)
  estado_cliente   EstadoCliente      @default(ACTIVO)
  es_socio         Boolean            @default(false)
  categoriaId      Int?
  password         String?
  vencimientoCuota DateTime?
  saldo            Float              @default(0)
  origenSolicitud  String?            @default("NUEVO")
  categoria        Categoria?         @relation(fields: [categoriaId], references: [id])
  movimientocuenta movimientocuenta[]
  pago             pago[]
  records          Record[]
  rutinas          Rutina[]
  turnosCliente    TurnoCliente[]

  @@index([categoriaId], map: "clientes_categoriaId_fkey")
  @@map("clientes")
}

model Profesional {
  id             Int             @id @default(autoincrement())
  nombre         String
  apellido       String
  dni            String          @unique
  especialidad   String?
  matricula      String?
  email          String?         @unique
  telefono       String?
  activo         Boolean         @default(true)
  tarifaPorClase Float           @default(0)
  categorias     Categoria[]
  horarios       HorarioConfig[]
  liquidaciones  Liquidacion[]
  turnosCliente  TurnoCliente[]

  @@map("profesionales")
}

model HorarioConfig {
  id            Int            @id @default(autoincrement())
  dia_semana    Int
  hora_inicio   DateTime       @db.Time(0)
  hora_fin      DateTime       @db.Time(0)
  activo        Boolean        @default(true)
  categoriaId   Int?
  cupo_maximo   Int?
  profesionalId Int?
  categoria     Categoria?     @relation(fields: [categoriaId], references: [id])
  profesional   Profesional?   @relation(fields: [profesionalId], references: [id])
  turnos        TurnoCliente[]

  @@index([categoriaId], map: "horarios_config_categoriaId_fkey")
  @@index([profesionalId], map: "horarios_config_profesionalId_fkey")
  @@map("horarios_config")
}

model TurnoCliente {
  id            Int           @id @default(autoincrement())
  fecha         DateTime      @db.Date
  horarioId     Int
  clienteId     Int
  profesionalId Int?
  cliente       Cliente       @relation(fields: [clienteId], references: [id])
  horario       HorarioConfig @relation(fields: [horarioId], references: [id])
  profesional   Profesional?  @relation(fields: [profesionalId], references: [id])

  @@unique([fecha, horarioId, clienteId])
  @@index([clienteId], map: "turnos_clientes_clienteId_fkey")
  @@index([horarioId], map: "turnos_clientes_horarioId_fkey")
  @@index([profesionalId], map: "turnos_clientes_profesionalId_fkey")
  @@map("turnos_clientes")
}

model Categoria {
  id            Int             @id @default(autoincrement())
  nombre        String
  rubro_sector  String?
  color         String?
  activo        Boolean         @default(true)
  planId        Int?
  profesionalId Int?
  plan          Plan?           @relation(fields: [planId], references: [id])
  profesional   Profesional?    @relation(fields: [profesionalId], references: [id])
  clientes      Cliente[]
  horarios      HorarioConfig[]

  @@index([planId], map: "categorias_planId_fkey")
  @@index([profesionalId], map: "categorias_profesionalId_fkey")
  @@map("categorias")
}

model Configuracion {
  id                       Int     @id @default(1)
  nombreGimnasio           String?
  logoBase64               String? @db.LongText
  bloqueoCapacidad         Boolean @default(false)
  cupoGlobal               Int     @default(15)
  limiteCancelacionMinutos Int     @default(60)
  adminApellido            String?
  adminDni                 String?
  adminEmail               String?
  adminNombre              String?
  diasApertura             String? @default("1,2,3,4,5,6")
  profesoresPorTurno       Boolean @default(false)
  maxReservasSemana        Int     @default(0)
  diaMaximoCobro           Int     @default(10)
  recargoPorcentaje        Float   @default(10.0)

  @@map("configuracion")
}

model Aviso {
  id                 Int       @id @default(autoincrement())
  titulo             String
  mensaje            String?   @db.Text
  tipo               String    @default("INFO")
  fechaDesde         DateTime  @db.Date
  fechaHasta         DateTime? @db.Date
  activo             Boolean   @default(true)
  bloquearTodoElDia  Boolean   @default(true)
  esBloqueo          Boolean   @default(false)
  horaFinBloqueo     String?
  horaInicioBloqueo  String?
  horariosBloqueados String?   @db.LongText

  @@map("avisos")
}

model CalendarioNota {
  id         Int     @id @default(autoincrement())
  fecha      String
  contenido  String  @db.Text
  horaAlarma String?
  notificado Boolean @default(false)

  @@map("calendario_notas")
}

model Rutina {
  id         Int               @id @default(autoincrement())
  nombre     String
  clienteId  Int?
  createdAt  DateTime          @default(now())
  ejercicios RutinaEjercicio[]
  cliente    Cliente?          @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId], map: "rutinas_clienteId_fkey")
  @@map("rutinas")
}

model RutinaEjercicio {
  id              Int     @id @default(autoincrement())
  rutinaId        Int
  nombreEjercicio String
  series          Int
  repeticiones    String
  pesoSugerido    String?
  pesoReal        String?
  dia             String?
  rutina          Rutina  @relation(fields: [rutinaId], references: [id], onDelete: Cascade)

  @@index([rutinaId], map: "rutina_ejercicios_rutinaId_fkey")
  @@map("rutina_ejercicios")
}

model Record {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  ejercicio  String
  pesoMaximo Float
  fecha      DateTime @default(now())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, ejercicio])
  @@map("records")
}

model ParametroSistema {
  id          Int    @id @default(autoincrement())
  clave       String @unique
  descripcion String
  tipo        String @default("boolean")
  valor       String @default("false")

  @@map("parametros_sistema")
}

model Liquidacion {
  id              Int                 @id @default(autoincrement())
  profesionalId   Int
  periodo         String
  clasesSemanales Int
  montoTotal      Float
  fechaPago       DateTime            @default(now())
  metodoPago      String
  notas           String?
  profesional     Profesional         @relation(fields: [profesionalId], references: [id])
  movimientos     MovimientoGeneral[]

  @@index([profesionalId], map: "liquidaciones_profesionalId_fkey")
  @@map("liquidaciones")
}

model MovimientoGeneral {
  id            Int          @id @default(autoincrement())
  tipo          String
  monto         Float
  descripcion   String
  fecha         DateTime     @default(now())
  origen        String
  pagoId        Int?
  liquidacionId Int?
  liquidacion   Liquidacion? @relation(fields: [liquidacionId], references: [id])
  pago          pago?        @relation(fields: [pagoId], references: [id])

  @@index([liquidacionId], map: "movimientos_generales_liquidacionId_fkey")
  @@index([pagoId], map: "movimientos_generales_pagoId_fkey")
  @@map("movimientos_generales")
}

model movimientocuenta {
  id          Int      @id @default(autoincrement())
  monto       Float
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  clienteId   Int
  pagoId      Int?
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade, map: "MovimientoCuenta_clienteId_fkey")
  pago        pago?    @relation(fields: [pagoId], references: [id], map: "MovimientoCuenta_pagoId_fkey")

  @@index([clienteId], map: "MovimientoCuenta_clienteId_fkey")
  @@index([pagoId], map: "MovimientoCuenta_pagoId_fkey")
}

model pago {
  id                   Int                 @id @default(autoincrement())
  clienteId            Int
  monto                Float
  metodoPago           String
  concepto             String
  fecha                DateTime            @default(now())
  notas                String?
  estado               String              @default("APROBADO")
  movimientocuenta     movimientocuenta[]
  movimientosGenerales MovimientoGeneral[]
  cliente              Cliente             @relation(fields: [clienteId], references: [id], map: "Pago_clienteId_fkey")

  @@index([clienteId], map: "Pago_clienteId_fkey")
}

enum EstadoPago {
  ALDIA
  MOROSO
}

enum EstadoCliente {
  ACTIVO
  INACTIVO
  PENDIENTE
}
